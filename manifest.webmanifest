{
  "name": "Excel to CSV Converter",
  "short_name": "Excel to CSV",
  "description": "Convert XLSX and XLS sheets to clean CSV in your browser, pick the sheet and delimiter, nothing uploaded. Free and open source, nothing is uploaded, works offli",
